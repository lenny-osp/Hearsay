    "%@ call failed (exit code %d). Check the model and reasoning effort in Settings > AI." : {
      "comment" : "Meeting notes error. %1$@ is a CLI name, %2$d the exit code.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aufruf von %1$@ fehlgeschlagen (Exit-Code %2$d). Modell und Denkaufwand unter Einstellungen > KI prüfen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ call failed (exit code %2$d). Check the model and reasoning effort in Settings > AI."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Error en la llamada a %1$@ (código de salida %2$d). Comprueba el modelo y el esfuerzo de razonamiento en Ajustes > IA."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 调用失败（退出代码 %2$d）。请在“设置 > AI”中检查模型和推理强度。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 呼叫失敗（結束代碼 %2$d）。請在「設定 > AI」中檢查模型與推理強度。"
          }
        }
      }
    },
    "%@ could not be started: %@" : {
      "comment" : "Meeting notes error. %1$@ is a CLI name, %2$@ a technical detail.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ konnte nicht gestartet werden: %2$@"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ could not be started: %2$@"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se ha podido iniciar %1$@: %2$@"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法启动 %1$@：%2$@"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無法啟動 %1$@：%2$@"
          }
        }
      }
    },
    "%@ did not answer within %lld minutes and was stopped." : {
      "comment" : "Meeting notes error. %1$@ is a CLI name, %2$lld a number of minutes.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ hat nicht innerhalb von %2$lld Minuten geantwortet und wurde gestoppt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ did not answer within %2$lld minutes and was stopped."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ no ha respondido en %2$lld minutos y se ha detenido."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 在 %2$lld 分钟内没有响应，已被停止。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 未在 %2$lld 分鐘內回應，已被停止。"
          }
        }
      }
    },
    "%@ is %lld bytes but the server announced %lld. The file was discarded; try again." : {
      "comment" : "Model download error. %1$@ is a file name, %2$lld and %3$lld are byte counts.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ ist %2$lld Byte groß, der Server hat aber %3$lld angekündigt. Die Datei wurde verworfen. Bitte erneut versuchen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ is %2$lld bytes but the server announced %3$lld. The file was discarded; try again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ ocupa %2$lld bytes, pero el servidor anunció %3$lld. Se ha descartado el archivo; inténtalo de nuevo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 为 %2$lld 字节，但服务器声明为 %3$lld 字节。该文件已丢弃，请重试。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 為 %2$lld 位元組，但伺服器宣告為 %3$lld。檔案已捨棄，請再試一次。"
          }
        }
      }
    },
    "%@ is not available for recording. Reconnect it or choose another input." : {
      "comment" : "Recording error. %@ is the input device name.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ist für die Aufnahme nicht verfügbar. Gerät erneut verbinden oder einen anderen Eingang wählen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ no está disponible para grabar. Vuelve a conectarlo o elige otra entrada."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 无法用于录音。请重新连接或选择其他输入设备。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 無法用於錄音。請重新連接，或選擇其他輸入裝置。"
          }
        }
      }
    },
    "%@ is not logged in. Run `%@` once in Terminal to log in with your ChatGPT account." : {
      "comment" : "Meeting notes error. %1$@ is a CLI name, %2$@ a shell command.",
