    "No audio from %@. Nothing arrived within %lld seconds, so the recording was stopped. Check that the device is connected and not muted, or choose another input." : {
      "comment" : "Recording error. %1$@ is the input device name, %2$lld a number of seconds.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kein Audio von %1$@. Innerhalb von %2$lld Sekunden kam nichts an, daher wurde die Aufnahme gestoppt. Prüfen, ob das Gerät verbunden und nicht stummgeschaltet ist, oder einen anderen Eingang wählen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "No audio from %1$@. Nothing arrived within %2$lld seconds, so the recording was stopped. Check that the device is connected and not muted, or choose another input."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No llega audio de %1$@. No ha llegado nada en %2$lld segundos, así que se ha detenido la grabación. Comprueba que el dispositivo esté conectado y no silenciado, o elige otra entrada."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 没有音频。%2$lld 秒内未收到任何声音，因此录音已停止。请检查设备是否已连接且未静音，或选择其他输入设备。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 沒有音訊。%2$lld 秒內未收到任何聲音，因此已停止錄音。請確認裝置已連接且未靜音，或選擇其他輸入裝置。"
          }
        }
      }
