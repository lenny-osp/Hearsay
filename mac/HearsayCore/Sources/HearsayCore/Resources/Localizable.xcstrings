    },
    "Hearsay has no microphone access. Allow it in System Settings > Privacy & Security > Microphone." : {
      "comment" : "Recording error. Use the macOS wording for the System Settings path.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hearsay hat keinen Zugriff auf das Mikrofon. Unter Systemeinstellungen > Datenschutz & Sicherheit > Mikrofon erlauben."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hearsay no tiene acceso al micrófono. Permítelo en Ajustes del Sistema > Privacidad y seguridad > Micrófono."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hearsay 没有麦克风访问权限。请在“系统设置 > 隐私与安全性 > 麦克风”中允许。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hearsay 沒有麥克風取用權限。請在「系統設定 > 隱私權與安全性 > 麥克風」中允許。"
          }
        }
      }
    },
    "Hearsay has no system audio access. Allow it in System Settings > Privacy & Security > Screen & System Audio Recording, then start a new recording." : {
      "comment" : "Recording error. Use the macOS wording for the System Settings path.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hearsay hat keinen Zugriff auf Systemaudio. Unter Systemeinstellungen > Datenschutz & Sicherheit > Bildschirm- & Systemaudioaufnahme erlauben und dann eine neue Aufnahme starten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hearsay no tiene acceso al audio del sistema. Permítelo en Ajustes del Sistema > Privacidad y seguridad > Grabación de pantalla y audio del sistema y, a continuación, inicia una nueva grabación."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hearsay 没有系统声音访问权限。请在“系统设置 > 隐私与安全性 > 录屏与系统录音”中允许，然后开始新的录音。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hearsay 沒有系統聲音取用權限。請在「系統設定 > 隱私權與安全性 > 螢幕與系統錄音」中允許，然後開始新的錄音。"
          }
        }
      }
    },
    "Hearsay is running from the disk image. Drag Hearsay to the Applications folder, open it from there, then check for updates again." : {
      "comment" : "Update install error: the app runs from the mounted DMG",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hearsay wird vom Image ausgeführt. Hearsay in den Ordner „Programme“ ziehen, dort öffnen und dann erneut nach Updates suchen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hearsay se está ejecutando desde la imagen de disco. Arrastra Hearsay a la carpeta Aplicaciones, ábrelo desde allí y vuelve a buscar actualizaciones."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hearsay 正从磁盘映像运行。请将 Hearsay 拖到“应用程序”文件夹，从那里打开后再检查更新。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hearsay 正從磁碟映像檔執行。請將 Hearsay 拖到「應用程式」資料夾，從那裡打開後再檢查更新。"
