    "Auto detects English, Chinese, German, or Spanish from the first speech. ZH-TW writes Traditional characters, ZH-CN Simplified." : {
      "comment" : "Tooltip of the language picker. ZH-TW and ZH-CN are the picker's labels; keep them as they are.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Automatisch“ erkennt Englisch, Chinesisch, Deutsch oder Spanisch an den ersten gesprochenen Worten. ZH-TW schreibt traditionelle Schriftzeichen, ZH-CN vereinfachte."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automático detecta inglés, chino, alemán o español con las primeras palabras. ZH-TW escribe caracteres tradicionales; ZH-CN, simplificados."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“自动”会根据最先出现的语音识别英语、中文、德语或西班牙语。ZH-TW 以繁体字书写，ZH-CN 以简体字书写。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「自動」會根據最初的語音偵測英文、中文、德文或西班牙文。ZH-TW 以繁體字書寫，ZH-CN 以簡體字書寫。"
          }
        }
      }
    },
    "Auto mode default language" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
