    },
    "This Hearsay build is not signed with a Developer ID, so macOS treats each update as a new app and forgets the permission you gave before." : {
      "comment" : "Permission sheet explanation",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Hearsay-Build ist nicht mit einer Developer ID signiert. Deshalb behandelt macOS jedes Update als neue App und vergisst die zuvor erteilte Berechtigung."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta versión de Hearsay no está firmada con un Developer ID, así que macOS trata cada actualización como una app nueva y olvida el permiso que diste antes."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这个 Hearsay 版本没有使用 Developer ID 签名，因此 macOS 会把每次更新都视为新的应用，并忘记你之前授予的权限。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這個 Hearsay 版本沒有使用 Developer ID 簽署，因此 macOS 會把每次更新都視為新的 App，並忘記你先前給予的權限。"
          }
        }
      }
    },
    "This build of Hearsay has no update repository set." : {
      "comment" : "Update check error: Info.plist has no HearsayUpdateRepository",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Für diese Version von Hearsay ist kein Update-Repository festgelegt."
          }
        },
