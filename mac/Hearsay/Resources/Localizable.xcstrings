    "%@ is already used by another app or shortcut." : {
      "comment" : "Settings > General error. %@ is a shortcut such as ⌃⌥⌘R.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ wird bereits von einer anderen App oder einem anderen Tastaturkurzbefehl verwendet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ya lo usa otra app u otro atajo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 已被其他应用或快捷键占用。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 已被其他 App 或快速鍵使用。"
          }
        }
      }
    },
    "%@ is replaced by the notes language. The filename and JSON rules and the transcript are always appended." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ wird durch die Notizsprache ersetzt. Die Regeln für Dateiname und JSON sowie das Transkript werden immer angehängt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ se sustituye por el idioma de las notas. Las reglas del nombre de archivo y del JSON y la transcripción se añaden siempre."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 会被替换为笔记语言。文件名和 JSON 规则以及转录稿始终会附加在末尾。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 會替換為筆記語言。檔名與 JSON 規則以及逐字稿一律會附加在後面。"
          }
        }
      }
    },
