<Project Sdk="Microsoft.NET.Sdk">

  <!-- Ported logic with no UI and no whisper.cpp: naming, prompt, SRT,
       language decision, mixer rules. Mirrors mac/HearsayCore. -->
  <PropertyGroup>
    <RootNamespace>Hearsay.Core</RootNamespace>
    <AssemblyName>Hearsay.Core</AssemblyName>
  </PropertyGroup>

  <!-- WASAPI capture (PLAN.md 18.3). NAudio.Wasapi alone (it brings
       NAudio.Core) rather than the NAudio metapackage, which adds WinForms,
       WinMM, ASIO and MIDI assemblies Hearsay does not use. -->
  <ItemGroup>
    <PackageReference Include="NAudio.Wasapi" Version="3.1.0" />
  </ItemGroup>

  <!-- The tests reach internal helpers the way the Swift tests use
       @testable import. -->
  <ItemGroup>
    <InternalsVisibleTo Include="Hearsay.Tests" />
  </ItemGroup>

  <!-- The meeting-notes prompt text, embedded straight from shared/prompts
       (AGENTS.md: Windows never keeps a copy of a shared file). Embedded
       resources are copied byte for byte, so the LF newlines survive.
       Read through Hearsay.Core.Notes.MeetingPrompt; a test compares the
       embedded bytes with the files on disk. -->
  <ItemGroup>
    <EmbeddedResource Include="$(HearsaySharedDir)prompts\*.txt;$(HearsaySharedDir)prompts\languages.json"
                      LogicalName="Hearsay.Core.Prompts.%(Filename)%(Extension)"
                      Visible="false" />
  </ItemGroup>

  <!-- The Windows model list (whisper.cpp GGML files, shared schema in
       shared/models/README.md). Windows-only, so it lives here; read
       through Hearsay.Core.ModelStore.ModelCatalog.Bundled(). -->
  <ItemGroup>
    <EmbeddedResource Include="Resources\ModelCatalog.json"
                      LogicalName="Hearsay.Core.Resources.ModelCatalog.json" />
  </ItemGroup>

</Project>
