<?xml version="1.0" encoding="utf-8"?>
<!-- The Settings tab: General, Window, Output, AI
     (mac/Hearsay/Features/Settings/SettingsView.swift). -->
<UserControl
    x:Class="Hearsay.App.Features.Settings.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:settings="using:Hearsay.App.Features.Settings">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <SelectorBar
            x:Name="Sections"
            Grid.Row="0"
            HorizontalAlignment="Center"
            Margin="0,8,0,0"
            SelectionChanged="OnSectionChanged">
            <SelectorBarItem x:Name="GeneralItem" Tag="General" />
            <SelectorBarItem x:Name="WindowItem" Tag="Window" />
            <SelectorBarItem x:Name="OutputItem" Tag="Output" />
            <SelectorBarItem x:Name="AIItem" Tag="AI" />
        </SelectorBar>
        <ScrollViewer
            Grid.Row="1"
            x:Name="Scroller"
            VerticalScrollBarVisibility="Auto"
            HorizontalScrollBarVisibility="Disabled"
            HorizontalScrollMode="Disabled">
            <!-- 720 wide plus the 24 margins, centered at any window width. -->
            <settings:CenteredColumn MaxColumnWidth="768">
                <ContentControl
                    x:Name="PaneContent"
                    Margin="24,4,24,24"
                    HorizontalContentAlignment="Stretch" />
            </settings:CenteredColumn>
        </ScrollViewer>
    </Grid>
</UserControl>
