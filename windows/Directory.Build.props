<Project>
  <!-- Settings every Windows project shares (AGENTS.md, Conventions). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningLevel>9999</WarningLevel>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <InvariantGlobalization>false</InvariantGlobalization>
    <Deterministic>true</Deterministic>
    <!-- Absolute path of the repo's shared/ folder, for tests and resource copying. -->
    <HearsaySharedDir>$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)..', 'shared'))</HearsaySharedDir>
  </PropertyGroup>
</Project>
